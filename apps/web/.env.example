# API Configuration
# Point to your backend API. When VITE_USE_MOCKS is enabled, this is bypassed.
VITE_API_BASE_URL=http://localhost:8000/api/v1

VITE_API_OAUTH_ENDPOINT="/auth/oauth/google"

# Mock Service Worker
# Set to "true" to enable MSW (Mock Service Worker) for frontend testing without a backend.
# Useful for development and UI testing.
# Set to "false" or omit to use real API endpoint.
VITE_USE_MOCKS=false
